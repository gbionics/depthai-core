include(CMakeFindDependencyMacro)

find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(libnop CONFIG REQUIRED)
find_dependency(XLink CONFIG REQUIRED COMPONENTS XLinkPublic)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(yaml-cpp CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(BZip2 REQUIRED)
find_dependency(ZLIB REQUIRED)
find_dependency(LibArchive REQUIRED)
find_dependency(LibLZMA REQUIRED)
if(NOT TARGET liblzma::liblzma AND TARGET LibLZMA::LibLZMA)
    add_library(liblzma::liblzma ALIAS LibLZMA::LibLZMA)
endif()
find_package(lz4 CONFIG QUIET)
if(NOT TARGET lz4::lz4)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(LIBLZ4 REQUIRED IMPORTED_TARGET liblz4)
    add_library(lz4::lz4 INTERFACE IMPORTED)
    target_link_libraries(lz4::lz4 INTERFACE PkgConfig::LIBLZ4)
endif()
find_dependency(Eigen3 CONFIG REQUIRED)
find_dependency(httplib CONFIG REQUIRED)
find_dependency(semver CONFIG REQUIRED)
find_dependency(magic_enum CONFIG REQUIRED)

set(DEPTHAI_OPENCV_SUPPORT @DEPTHAI_OPENCV_SUPPORT@)
set(DEPTHAI_PCL_SUPPORT @DEPTHAI_PCL_SUPPORT@)
set(DEPTHAI_XTENSOR_SUPPORT @DEPTHAI_XTENSOR_SUPPORT@)
set(DEPTHAI_DYNAMIC_CALIBRATION_SUPPORT @DEPTHAI_DYNAMIC_CALIBRATION_SUPPORT@)

if(DEPTHAI_OPENCV_SUPPORT)
    find_dependency(OpenCV CONFIG REQUIRED)
    if(OpenCV_VERSION VERSION_LESS "4")
        message(FATAL_ERROR "DepthAI requires OpenCV 4 or newer, but found ${OpenCV_VERSION}")
    endif()
endif()

if(DEPTHAI_PCL_SUPPORT)
    find_dependency(PCL CONFIG REQUIRED)
endif()

if(DEPTHAI_XTENSOR_SUPPORT)
    find_dependency(xtensor CONFIG REQUIRED)
endif()

# Add the targets file
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_EXPORT_GROUP@.cmake")

# Cleanup
set(_IMPORT_PREFIX)
